# STM32CubeIDE Build Output (Do Not Track)
Debug/
Release/
[Dd]ebug/
[Rr]elease/

# Individual build artifacts
*.o
*.d
*.su
*.elf
*.bin
*.hex
*.map
*.list
*.cyclo

# IDE & Machine-Specific Files
# Workspace metadata directory
.metadata/

# Local preferences (contains absolute paths and user-specific layout preferences)
.settings/

# Local debug and hardware programmer launch configurations
*.launch
*.jlink

# TouchGFX autogenerated files (if using TouchGFX)
TouchGFX/generated/
